              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          },
          "wacc": {
            "$ref": "#/$defs/positive"
          },
          "terminal_growth": {
            "$ref": "#/$defs/rate"
          },
          "terminal_margin": {
            "$ref": "#/$defs/rate"
          },
          "terminal_roic": {
            "$ref": "#/$defs/positive"
          },
          "tax_rate": {
            "$ref": "#/$defs/fraction"
          },
          "stub": {
            "type": "object",
            "properties": {
              "revenue": {
                "$ref": "#/$defs/number"
              },
              "ebit": {
                "$ref": "#/$defs/number"
              },
              "cash_tax": {
                "$ref": "#/$defs/number"
              },
              "da": {
                "$ref": "#/$defs/number"
              },
              "capex": {
                "$ref": "#/$defs/number"
              },
              "delta_nwc": {
                "$ref": "#/$defs/number"
              },
              "opening_nwc": {
                "$ref": "#/$defs/number"
              },
              "closing_nwc": {
                "$ref": "#/$defs/number"
