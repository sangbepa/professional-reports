          "name",
          "revenue",
          "reported_ebit",
          "debt",
          "cash",
          "lease_liability",
          "parent_ownership",
          "nci_method",
          "lease_policy",
          "lease_basis",
          "opening_nwc_rate",
          "forecast",
          "wacc",
          "terminal_growth",
          "terminal_margin",
          "terminal_roic",
          "tax_rate"
