                "reviewer": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reviewer",
                "reference"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "value",
            "kind",
            "source",
            "as_of",
            "unit",
            "rationale",
            "review"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "time_to_cashflow",
        "terminal_time",
        "finance_stub_charge"
      ],
      "additionalProperties": false
    },
