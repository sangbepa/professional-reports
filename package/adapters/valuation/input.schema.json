{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conditional segmented valuation input",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0-dev.1"
      ]
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "currency": {
      "type": "string",
      "pattern": "[A-Z]{3}"
    },
    "amount_scale": {
      "$ref": "#/$defs/positive"
    },
    "valuation_date": {
      "type": "string",
      "format": "date"
    },
    "base_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 9990
    },
    "horizon": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "discount_timing": {
      "$ref": "#/$defs/timing"
    },
    "industrial": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z][A-Za-z0-9_-]{0,30}"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "revenue": {
            "$ref": "#/$defs/positive"
          },
          "reported_ebit": {
            "$ref": "#/$defs/number"
          },
          "debt": {
            "$ref": "#/$defs/nonnegative"
          },
          "cash": {
            "$ref": "#/$defs/nonnegative"
          },
          "lease_liability": {
            "$ref": "#/$defs/nonnegative"
          },
          "parent_ownership": {
            "$ref": "#/$defs/fraction"
          },
          "nci_method": {
            "$ref": "#/$defs/nci_method"
          },
          "lease_policy": {
            "$ref": "#/$defs/lease_policy"
          },
          "lease_basis": {
            "$ref": "#/$defs/text_atom"
          },
          "opening_nwc_rate": {
            "$ref": "#/$defs/rate"
          },
          "forecast": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "growth": {
                  "$ref": "#/$defs/rate"
                },
                "margin": {
                  "$ref": "#/$defs/rate"
                },
                "da_rate": {
                  "$ref": "#/$defs/rate"
                },
                "capex_rate": {
                  "$ref": "#/$defs/rate"
                },
                "nwc_rate": {
                  "$ref": "#/$defs/rate"
                }
              },
              "required": [
                "growth",
                "margin",
                "da_rate",
                "capex_rate",
                "nwc_rate"
