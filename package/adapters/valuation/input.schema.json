          "type": "object",
          "properties": {
            "value": {
              "enum": [
                "compound_effective_rate"
              ]
            },
            "kind": {
              "enum": [
                "evidence",
                "assumption",
                "synthetic"
              ]
            },
            "source": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "uri": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "(?:[0-9a-f]{64})?"
                }
              },
              "required": [
                "id",
                "locator",
                "uri",
                "sha256"
              ],
              "additionalProperties": false
            },
            "as_of": {
              "type": "string",
              "format": "date"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "review": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "unreviewed",
                    "reviewed",
                    "rejected"
                  ]
