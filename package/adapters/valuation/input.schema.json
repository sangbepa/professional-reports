        },
        "report_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "[A-Za-z][A-Za-z0-9_-]{0,60}"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "lead": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "argument",
                        "evidence",
                        "condition",
                        "paragraph"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 0,
                      "maxItems": 50
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "evidence_ids"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 100
              }
            },
            "required": [
              "id",
              "title",
              "lead",
              "blocks"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "section_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "class_cashflows": {
      "type": "object",
      "properties": {
        "terminal_time": {
          "$ref": "#/$defs/positive"
        },
        "terminal_total_claim": {
          "$ref": "#/$defs/nonnegative"
        },
        "parent_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/class_owner_event"
          },
          "maxItems": 1000
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/class_distribution_stream"
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "terminal_time",
        "terminal_total_claim",
        "parent_events",
        "classes"
      ],
      "additionalProperties": false,
      "description": "Explicit parent and class owner cashflows in model amount units for existing cutoff holders only. Each class explicitly supplies every parent event, including zero; discount times are years after valuation date. No inferred rights, changing cohorts or automatic sensitivity repricing."
    }
  },
  "required": [
