        "ebit_eliminations": {
          "$ref": "#/$defs/number"
        },
        "debt_eliminations": {
          "$ref": "#/$defs/number"
        },
        "cash_eliminations": {
          "$ref": "#/$defs/number"
        },
        "consolidated_revenue": {
