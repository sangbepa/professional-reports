    "finance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z][A-Za-z0-9_-]{0,30}"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "revenue": {
            "$ref": "#/$defs/number"
          },
          "reported_ebit": {
            "$ref": "#/$defs/number"
          },
          "book_equity": {
            "$ref": "#/$defs/positive"
          },
          "funding_debt": {
            "$ref": "#/$defs/nonnegative"
          },
          "cash": {
            "$ref": "#/$defs/nonnegative"
          },
          "parent_ownership": {
            "$ref": "#/$defs/fraction"
          },
          "nci_method": {
            "$ref": "#/$defs/finance_nci_method"
          },
          "finance_basis": {
            "$ref": "#/$defs/text_atom"
          },
          "forecast": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "roe": {
                  "$ref": "#/$defs/rate"
                },
                "payout": {
                  "$ref": "#/$defs/fraction"
                }
              },
              "required": [
                "roe",
                "payout"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          },
          "cost_equity": {
            "$ref": "#/$defs/positive"
          },
          "terminal_growth": {
            "$ref": "#/$defs/rate"
          },
          "terminal_roe": {
            "$ref": "#/$defs/positive"
          },
          "pb_multiple": {
            "$ref": "#/$defs/nonnegative"
          },
          "stub": {
            "type": "object",
            "properties": {
              "income": {
