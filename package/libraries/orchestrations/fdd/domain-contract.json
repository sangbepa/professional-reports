{
  "id": "fdd-domain-contract",
  "component_id": "fdd",
  "version": "0.1.0-dev.1",
  "status": "provisional",
  "execution_support": "planning-only",
  "production_quality_verified": false,
  "production_report_execution_allowed": false,
  "files": {
    "policy": "POLICY.md",
    "rules": "plan-rules.json"
  },
  "interface": {
    "inputs": [
      "mandate",
      "company_profile",
      "facts",
      "evidence_access_manifest"
    ],
    "mandate_fields": [
      "transaction_role",
      "transaction_stage",
      "acquired_perimeter",
      "information_cutoff",
      "record_access",
      "price_mechanism_if_known"
    ],
    "outputs": [
      "required_work",
      "gates",
      "unknowns",
      "capability_gaps"
    ],
    "required_work": [
      "quality-of-earnings-test-plan",
      "working-capital-test-plan",
      "debt-and-cash-classification-plan",
      "population-and-access-gaps"
    ],
    "gates": [
      {
        "id": "fdd-gate-scope",
        "status": "pending",
        "review_role": "judgment"
      },
      {
        "id": "fdd-gate-evidence-access",
        "status": "pending",
        "review_role": "source"
      },
      {
        "id": "fdd-gate-production-execution",
        "status": "blocked",
        "reason": "Planning-only domain; no report-mode execution support."
      }
    ],
    "unknown_fields": [
      "question",
      "affected_work",
      "missing_evidence",
      "next_assessment",
      "conclusion_restriction"
    ],
    "engine_node_output_names": [
      "fdd-research-plan",
      "fdd-access-and-capability-gaps"
    ],
    "component_reference_fields": [
      "id",
      "version",
      "sha256"
    ]
  },
  "basis_clauses": [
    "fdd-rule-planning",
    "fdd-policy-production-block"
  ],
  "host_ownership": {
    "meta_component_id": "meta-orchestrator",
    "runtime_component_id": "codex-native"
  },
  "limitations": [
    "Planning instructions do not implement a completed domain engagement, calculations, assurance or investment approval.",
    "Unknown facts remain unknown; no access is not evidence of no issue.",
    "Any future execution support requires explicit versioned domain/provider coverage and actual review; a valuation adapter does not silently confer it."
  ]
}
