{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "retrieval/1"
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "embedding": {
      "type": [
        "object",
        "null"
      ]
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "chunking": {
      "type": "object"
    },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "publication_evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "sha256",
          "published_at",
          "publication_evidence"
        ],
        "additionalProperties": true
      },
      "minItems": 0
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "document_id",
          "document_sha256",
          "start",
          "end",
          "text"
        ],
        "additionalProperties": true
      },
      "minItems": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "engine",
    "embedding",
    "cutoff",
    "chunking",
    "corpus",
    "chunks",
    "sha256"
  ],
  "additionalProperties": true
}
