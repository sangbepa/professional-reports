{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "utc": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "boot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "seq",
    "previous",
    "kind",
    "utc",
    "monotonic_ns",
    "boot_id",
    "data",
    "sha256"
  ],
  "additionalProperties": true
}
