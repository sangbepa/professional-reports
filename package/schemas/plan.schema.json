{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professional-reports.local/schemas/v1/plan",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "clause": {
                  "type": "string",
                  "minLength": 1
                },
                "facts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "component",
                "clause",
                "facts",
                "reason"
              ],
              "additionalProperties": true
            },
            "minItems": 1
          },
          "expert": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "runtime": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "execution": {
            "enum": [
              "agent",
              "code",
              "human-gate"
            ]
          },
          "reasoning": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "none"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "consumes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "required_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "minItems": 0
          },
          "review_required": {
            "type": "boolean"
          },
          "review_role": {
            "enum": [
              "source",
              "model",
              "judgment",
              "document",
              null,
              "risk"
            ]
          },
          "producer_agent_id": {
            "type": "string",
            "minLength": 1
          },
          "environment_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "goal",
          "question",
          "basis",
          "expert",
          "skills",
          "runtime",
          "capabilities",
          "execution",
          "reasoning",
          "inputs",
          "consumes",
          "outputs",
          "required_checks",
          "depends_on",
          "review_required",
          "review_role"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "revision",
    "previous",
    "meta_hash",
    "reason",
    "actor",
    "facts",
    "nodes"
  ],
  "additionalProperties": true
}
